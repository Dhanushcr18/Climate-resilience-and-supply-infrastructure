# Optional NVIDIA NIM / CuOpt API Key (system has 100% offline built-in heuristic solver fallback)
NVIDIA_API_KEY=

# Optional Google Gemini API Key (system has deterministic transparent template explainability fallback)
GEMINI_API_KEY=

# Supabase shared simulation database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional server-only key; never expose this in client code
SUPABASE_SERVICE_ROLE_KEY=
